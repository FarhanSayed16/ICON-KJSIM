# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/icon2026?retryWrites=true&w=majority

# Authentication (JWT_SECRET must be a long random string, ideally 32+ bytes)
JWT_SECRET=your_32_byte_secret_key_here_change_me
ADMIN_PASSWORD=your_secure_admin_password
# Volunteer check-in PIN (defaults to ADMIN_PASSWORD if unset)
CHECKIN_PIN=123456

# Email / Notifications (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="ICON 2026 | K J Somaiya Institute of Management <onboarding@resend.dev>"
EMAIL_REPLY_TO=your.email@gmail.com
EMAIL_NOTIFY_TO=your.email@gmail.com

# SMS / WhatsApp (Twilio) — optional
# Trial SMS only reaches numbers you verify in the Twilio console.
SMS_ENABLED=false
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Cron (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace_with_long_random_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
